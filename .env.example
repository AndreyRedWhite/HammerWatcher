# Tinkoff Invest API (Read-only токен)
TINKOFF_TOKEN=replace_me

# Инструмент: укажи тикер как он виден в Тинькофф (или FIGI)
SYMBOL=MOEXF
FIGI=

# Таймфреймы через запятую: 1m,5m,15m,1h
TIMEFRAMES=1m,5m

# Сколько дней назад стянуть начальную историю (по умолчанию)
HISTORY_DAYS=30

# MSK таймзона для нормализации времени
TZ=Europe/Moscow

# TIMEFRAMES=1m,5m  (как есть)
# в коде уже: wick_mult=2.3, opp_wick_max_frac=0.70, vol_prct_min=0.80, atr_k_max=2.7
# если мало сигналов — опусти vol_prct_min до 0.70 временно
# если хватает, но слабые — подними vol_prct_min до 0.85 и min_range_ticks до 2.0

# Hammer detector tuning
HAMMER_BODY_MAX_FRAC=0.35
HAMMER_WICK_MULT=2.1
HAMMER_OPP_WICK_MAX_FRAC=0.90
HAMMER_EXT_WINDOW=4
HAMMER_EXT_EPS_TICKS=1.5
HAMMER_VOL_PRCT_MIN=0.65
HAMMER_ATR_K_MAX=3.2
HAMMER_MIN_RANGE_TICKS=0.5
HAMMER_CONFIRM_MODE=pullback   # classic | pullback



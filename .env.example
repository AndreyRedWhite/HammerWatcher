# Tinkoff Invest API (Read-only токен)
TINKOFF_TOKEN=replace_me

# Инструмент: укажи тикер как он виден в Тинькофф (или FIGI)
SYMBOL=MOEXF
FIGI=

# Таймфреймы через запятую: 1m,5m,15m,1h
TIMEFRAMES=1m,5m

# Сколько дней назад стянуть начальную историю (по умолчанию)
HISTORY_DAYS=30

# MSK таймзона для нормализации времени
TZ=Europe/Moscow
